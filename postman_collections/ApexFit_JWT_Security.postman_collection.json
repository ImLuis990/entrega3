              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Cliente\",\n  \"correo\": \"carlos@apexfit.com\",\n  \"contrasena\": \"123456\",\n  \"rol\": \"cliente\",\n  \"telefono\": \"3001234567\"\n}"
            }
