        {
          "name": "1.4 Login Administrador (Capturar Token Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Admin exitoso - Status code 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna JWT token y rol ADMINISTRADOR', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.roles).to.include('ROLE_ADMINISTRADOR');",
                  "    pm.collectionVariables.set('token_admin', json.token);",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.environment.set('token_admin', json.token);",
                  "    pm.environment.set('token', json.token);",
                  "});",
                  "pm.test('Tiempo de respuesta menor a 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]},
            "body": {
