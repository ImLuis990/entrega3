      "name": "🔒 11. Pruebas de Seguridad y Control de Roles (RBAC 401 y 403)",
      "item": [
        {
          "name": "11.1 Petición sin Token - Rechazo 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Acceso denegado con 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Mensaje de error indica falta de autorización', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error || json.message || json.status).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/ejercicios", "host": ["{{baseUrl}}"], "path": ["ejercicios"]}
          }
        },
        {
          "name": "11.2 Cliente intenta Crear Ejercicio - Rechazo 403 Forbidden",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('RBAC bloquea acción no permitida con 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Mensaje de error deniega por rol insuficiente', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_cliente}}"}
            ],
