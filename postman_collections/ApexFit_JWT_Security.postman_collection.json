{
  "info": {
    "name": "ApexFit API - FullStack Suite con Seguridad JWT y RBAC",
    "description": "Colección completa de pruebas para la API REST de ApexFit. Incluye autenticación JWT, control de acceso basado en roles (RBAC: Cliente, Entrenador, Administrador), pruebas CRUD para todas las entidades y más de 20 tests automatizados.",
    "_postman_id": "apexfit-jwt-collection-v3-complete",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_entrenador",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_cliente",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 1. Autenticación y Tokens",
      "item": [
        {
          "name": "1.1 Registrar Usuario Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK o 400 (si ya existe)', function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Respuesta contiene mensaje', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('mensaje');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Admin\",\n  \"apellido\": \"ApexFit\",\n  \"correo\": \"admin@apexfit.com\",\n  \"contrasena\": \"admin123\",\n  \"rol\": \"administrador\",\n  \"telefono\": \"3000000001\"\n}"
            }
          }
        },
