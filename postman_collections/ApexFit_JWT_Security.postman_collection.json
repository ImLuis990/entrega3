            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ejercicio No Autorizado\",\n  \"grupoMuscular\": \"Espalda\",\n  \"nivelDificultad\": \"principiante\"\n}"
            }
          }
        },
